{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tasks list output",
  "type": "object",
  "required": ["items", "total"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "done"],
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "done": {"type": "boolean"},
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    },
    "total": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
